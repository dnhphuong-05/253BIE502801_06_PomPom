<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/md_theme_light_background">

    <!-- Fragment Container with ViewPager2 for swiping — chiếm TRỌN màn hình, pill nổi nằm ĐÈ
         lên trên (không còn "nhường chỗ" cho nav nữa), để khi pill ẩn đi nội dung đã full sẵn
         từ trước, không bị hụt một khoảng trống nơi nav vừa đứng. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Custom Bottom Navigation Bar — nổi kiểu "liquid glass" (Threads): cách 2 mép + đáy màn
         hình, bo tròn toàn phần, không chạm rìa. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/bg_bottom_navigation_bar">

        <!-- 5-Column Grid for Perfect Balance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingTop="6dp"
            android:weightSum="5">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_home"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_home"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_home_border" />

                <TextView
                    android:id="@+id/tv_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/nav_home"
                    android:textColor="@color/nav_text_selector"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2. Shop -->
            <LinearLayout
                android:id="@+id/nav_shop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_shop"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_shop"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_shop_border" />

                <TextView
                    android:id="@+id/tv_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/nav_shop"
                    android:textColor="@color/nav_text_selector"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. AI Center (Placeholder for Frame) -->
            <FrameLayout
                android:id="@+id/ai_button_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btn_ai"
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:contentDescription="@string/nav_ai"
                    android:layout_gravity="center"
                    android:elevation="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ai" />
            </FrameLayout>

            <!-- 4. Community -->
            <LinearLayout
                android:id="@+id/nav_community"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_community"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_community"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_community_border" />

                <TextView
                    android:id="@+id/tv_community"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/nav_community"
                    android:textColor="@color/nav_text_selector"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 5. Me -->
            <LinearLayout
                android:id="@+id/nav_me"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_me"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_me"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_me_border" />

                <TextView
                    android:id="@+id/tv_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/nav_me"
                    android:textColor="@color/nav_text_selector"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Mascot -->
    <ImageView
        android:id="@+id/iv_floating_mascot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/mascot_pompom"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/mascot_description"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
