<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_light_primary"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <!-- ══ Top header bar ══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:paddingHorizontal="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:paddingLeft="12dp">

            <!-- Circular avatar (left) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatarProfile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/tvLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvLogo"
                app:strokeWidth="0dp"
                android:backgroundTint="@color/brand_pink"
                android:layout_marginLeft="6dp">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="22dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:paddingLeft="3dp"
                    android:src="@drawable/ic_user2"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Brand logo (center) -->
            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_bold"
                android:paddingHorizontal="10dp"
                android:text="Pom Pom"
                android:textColor="@color/brand_background"
                android:textSize="26sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Search icon -->
            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="@id/tvLogo"
                app:layout_constraintEnd_toStartOf="@id/cartIconContainer"
                app:layout_constraintTop_toTopOf="@id/tvLogo"
                app:tint="@color/brand_background" />

            <!-- Cart icon + badge (right) -->
            <FrameLayout
                android:id="@+id/cartIconContainer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clipChildren="false"
                app:layout_constraintBottom_toBottomOf="@id/tvLogo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvLogo">

                <ImageView
                    android:id="@+id/ivCart"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bag2"
                    app:tint="@color/brand_background" />

                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_green"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Marquee Promotion Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/brand_pink_light">

            <TextView
                android:id="@+id/tvPromoMarquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:paddingEnd="16dp"
                android:paddingStart="16dp"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Miễn phí vận chuyển cho đơn hàng từ 500.000đ"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══ Scrollable body ══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_light_background"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_shop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Categories -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Filter + Layout-Toggle bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Lọc button (clickable → FilterSheetFragment) -->
                <LinearLayout
                    android:id="@+id/layoutFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/brand_pink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Lọc"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvClearFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="| Xóa"
                        android:textColor="@color/brand_pink"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Row / Grid toggle icons (right side) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Row view toggle (1-col) -->
                    <ImageView
                        android:id="@+id/ivRowView"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        app:tint="@color/brand_pink"
                        android:src="@drawable/ic_rowview0" />

                    <!-- Grid view toggle (2-col, default selected) -->
                    <ImageView
                        android:id="@+id/ivGridView"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@null"
                        app:tint="@color/brand_pink"
                        android:src="@drawable/ic_gridview1" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Products RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
