<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <!-- fitsSystemWindows + statusBarForeground: tô vùng status bar trùng màu nền header,
         đúng quy chuẩn đang dùng ở fragment_home.xml/fragment_shop.xml. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_light_background"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:statusBarForeground="@color/md_theme_light_background">

        <!-- ══ Header cố định: logo/tên, tìm kiếm, thông báo ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:background="@color/md_theme_light_background">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Community"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_circle_pink"
                    app:layout_constraintStart_toEndOf="@id/tvTitle"
                    app:layout_constraintTop_toTopOf="@id/tvTitle"
                    android:layout_marginTop="6dp"/>

                <ImageView
                    android:id="@+id/btnAiAssistant"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_star_magic"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                    app:layout_constraintTop_toTopOf="@id/tvTitle"
                    app:tint="@color/text_primary"
                    android:contentDescription="@null" />

                <FrameLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/text_primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_pink"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/layoutSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_white_pill_button"
                    android:backgroundTint="@color/white"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnPlus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Tìm bài viết cộng đồng..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_pin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary"
                    android:contentDescription="@null" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ══ 4 tab nội dung chính ══ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tabReels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Thước phim"
                    android:textColor="@color/brand_pink"
                    android:textSize="12.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabBlog"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabBlog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Blog"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabTips"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabReels"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabTips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Tips bác sĩ"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabNearby"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabBlog"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabNearby"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Tin gần đây"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabTips"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Tab Indicator Underline -->
                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_label_pink"
                    app:layout_constraintEnd_toEndOf="@+id/tabReels"
                    app:layout_constraintStart_toStartOf="@+id/tabReels"
                    app:layout_constraintTop_toBottomOf="@+id/tabReels" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══ Nội dung theo tab đang chọn (chỉ 1 panel hiển thị) ══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Panel: Thước phim -->
            <LinearLayout
                android:id="@+id/panelReels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Bộ lọc theo nguồn mạng xã hội -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/chipSourceAll"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_label_pink"
                            android:text="Tất cả"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/chipSourceInstagram"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:text="Instagram" />

                        <TextView
                            android:id="@+id/chipSourceTiktok"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:text="TikTok" />

                        <TextView
                            android:id="@+id/chipSourceFacebook"
                            style="@style/ReelSourceChip"
                            android:text="Facebook" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReels"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="90dp" />
            </LinearLayout>

            <!-- Panel: Blog thương hiệu -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBlogFull"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="90dp"
                android:visibility="gone" />

            <!-- Panel: Tips bác sĩ (nút Liên hệ tư vấn cố định trên đầu + danh sách) -->
            <LinearLayout
                android:id="@+id/panelTips"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnContactConsult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_pink_gradient_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="💬 Liên hệ tư vấn với bác sĩ"
                    android:textColor="@color/white"
                    android:textSize="13.5sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTipsFull"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="90dp" />
            </LinearLayout>

            <!-- Panel: Tin gần đây (feed cộng đồng hiện có: Bài viết/Đã lưu/Của bạn) -->
            <LinearLayout
                android:id="@+id/panelNearby"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Stories 24h theo bán kính GPS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />

                <!-- Bộ lọc phụ của feed -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tabPosts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="Bài viết"
                        android:textColor="@color/brand_pink"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@+id/tabSaved"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tabSaved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="Đã lưu"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@+id/tabMyPosts"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/tabPosts"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tabMyPosts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="Của bạn"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/tabSaved"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/feedTabIndicator"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_label_pink"
                        app:layout_constraintEnd_toEndOf="@+id/tabPosts"
                        app:layout_constraintStart_toStartOf="@+id/tabPosts"
                        app:layout_constraintTop_toBottomOf="@+id/tabPosts" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFeed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="90dp" />

                        <TextView
                            android:id="@+id/tvFeedEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:paddingHorizontal="32dp"
                            android:text="Chưa có bài viết nào"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </LinearLayout>

            <!-- FAB: Đăng bài — chỉ hiện ở tab "Tin gần đây" -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="24dp"
                android:src="@drawable/ic_plus"
                app:backgroundTint="@color/brand_pink"
                app:tint="@color/white"
                app:elevation="6dp"
                android:visibility="gone"
                android:contentDescription="Tạo bài viết mới" />

            <!-- FAB: Liên hệ tư vấn — nổi xuyên suốt mọi tab -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabConsult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:src="@drawable/ic_chat"
                app:backgroundTint="@color/white"
                app:tint="@color/brand_pink"
                app:borderWidth="0dp"
                app:elevation="6dp"
                android:contentDescription="Liên hệ tư vấn" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
