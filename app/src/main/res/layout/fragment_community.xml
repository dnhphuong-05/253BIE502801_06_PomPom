<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <!-- fitsSystemWindows + statusBarForeground: tô vùng status bar trùng màu nền header
         (brand_pink), đồng nhất status bar/header giống các màn chi tiết khác. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_pink"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:statusBarForeground="@color/brand_pink">

        <!-- ══ Header cố định: tên, thông báo ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:background="@color/brand_pink">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Cộng đồng"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toStartOf="@id/ivUserAvatar"
                    app:layout_constraintTop_toTopOf="@id/tvTitle">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_white"
                        android:gravity="center"
                        android:textColor="@color/brand_pink"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="3"
                        tools:ignore="SmallSp" />
                </FrameLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user2"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    app:strokeColor="@color/white"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ══ 3 tab nội dung chính ══ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tabPosts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Bài viết"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabNearby"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabNearby"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Gần đây"
                    android:textColor="@color/brand_pink_light"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabDiscover"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabPosts"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabDiscover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Khám phá"
                    android:textColor="@color/brand_pink_light"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabNearby"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Tab Indicator Underline -->
                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="@+id/tabPosts"
                    app:layout_constraintStart_toStartOf="@+id/tabPosts"
                    app:layout_constraintTop_toBottomOf="@+id/tabPosts" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══ Nội dung theo tab đang chọn (chỉ 1 panel hiển thị) — vuốt ngang để chuyển tab ══ -->
    <com.pompom.group6.utils.SwipeTabFrameLayout
        android:id="@+id/tabContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Panel: Bài viết (feed cộng đồng UGC, tab mặc định) -->
        <LinearLayout
            android:id="@+id/postsTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Ô tìm kiếm bài viết theo chủ đề (?q=) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_white_pill_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Tìm bài viết, chủ đề..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingVertical="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Xoá tìm kiếm"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:id="@+id/panelPosts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFeed"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="90dp" />

                    <TextView
                        android:id="@+id/tvFeedEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingHorizontal="32dp"
                        android:text="Chưa có bài viết nào"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- Panel: Gần đây (story 24h + chọn khu vực theo bán kính GPS) -->
        <LinearLayout
            android:id="@+id/panelNearby"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Tag vị trí: bấm để đổi nơi xem story theo bán kính -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnChangeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="0dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/brand_pink" />

                    <TextView
                        android:id="@+id/tvLocationTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Vị trí hiện tại"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Story trong bán kính 100km quanh khu vực này"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Stories 24h theo bán kính GPS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/tvNearbyHint"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:text="Chạm vào một story để xem khoảnh khắc mọi người chia sẻ quanh bạn"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Panel: Khám phá (Blog thương hiệu + Tips bác sĩ, chuyển bằng chip) -->
        <LinearLayout
            android:id="@+id/panelDiscover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/chipDiscoverBlog"
                        style="@style/ReelSourceChip"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_label_pink"
                        android:text="Blog thương hiệu"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/chipDiscoverTips"
                        style="@style/ReelSourceChip"
                        android:text="Tips bác sĩ" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Nhóm Blog -->
                <FrameLayout
                    android:id="@+id/groupBlog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBlogFull"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="8dp"
                        android:paddingBottom="90dp" />

                    <TextView
                        android:id="@+id/tvBlogStatus"
                        style="@style/CommunityPanelStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:text="Đang tải..." />
                </FrameLayout>

                <!-- Nhóm Tips -->
                <FrameLayout
                    android:id="@+id/groupTips"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTipsFull"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="8dp"
                        android:paddingBottom="90dp" />

                    <TextView
                        android:id="@+id/tvTipsStatus"
                        style="@style/CommunityPanelStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:text="Đang tải..." />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Speed-dial nổi xuyên suốt mọi tab: bấm nút chính để nảy lên 2 lựa chọn -->
        <LinearLayout
            android:id="@+id/speedDialGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowConsult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="invisible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_white_pill_button"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Liên hệ tư vấn"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabConsult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fabSize="mini"
                    android:padding="10dp"
                    android:src="@drawable/ic_chat"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    app:maxImageSize="18dp"
                    app:backgroundTint="@color/white"
                    app:tint="@color/brand_pink"
                    app:borderWidth="0dp"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:hoveredFocusedTranslationZ="0dp"
                    android:contentDescription="Liên hệ tư vấn" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowCreatePost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="invisible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_white_pill_button"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Tạo bài viết"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fabSize="mini"
                    android:padding="10dp"
                    android:src="@drawable/ic_plus"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    app:maxImageSize="18dp"
                    app:backgroundTint="@color/white"
                    app:tint="@color/brand_pink"
                    app:borderWidth="0dp"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:hoveredFocusedTranslationZ="0dp"
                    android:contentDescription="Tạo bài viết mới" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMain"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end"
                android:padding="16dp"
                android:src="@drawable/ic_plus"
                app:shapeAppearanceOverlay="@style/CircleShape"
                app:maxImageSize="20dp"
                app:backgroundTint="@color/brand_pink"
                app:tint="@color/white"
                app:elevation="0dp"
                app:pressedTranslationZ="0dp"
                app:hoveredFocusedTranslationZ="0dp"
                android:contentDescription="Tạo bài viết / Liên hệ tư vấn" />

        </LinearLayout>

    </com.pompom.group6.utils.SwipeTabFrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
