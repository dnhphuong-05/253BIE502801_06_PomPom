<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <!-- fitsSystemWindows + statusBarForeground: tô vùng status bar trùng màu nền header
         (brand_pink), đồng nhất status bar/header giống các màn chi tiết khác. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_pink"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:statusBarForeground="@color/brand_pink">

        <!-- ══ Header cố định: tên, thông báo ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:background="@color/brand_pink">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Cộng đồng"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user2"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    app:strokeColor="@color/white"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                    app:layout_constraintTop_toTopOf="@id/tvTitle" />

                <FrameLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_white"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/brand_pink"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ══ 4 tab nội dung chính ══ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tabReels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Thước phim"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabBlog"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabBlog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Blog"
                    android:textColor="@color/brand_pink_light"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabTips"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabReels"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabTips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Tips bác sĩ"
                    android:textColor="@color/brand_pink_light"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toStartOf="@+id/tabNearby"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabBlog"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tabNearby"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Tin gần đây"
                    android:textColor="@color/brand_pink_light"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tabTips"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Tab Indicator Underline -->
                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="@+id/tabReels"
                    app:layout_constraintStart_toStartOf="@+id/tabReels"
                    app:layout_constraintTop_toBottomOf="@+id/tabReels" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══ Nội dung theo tab đang chọn (chỉ 1 panel hiển thị) — vuốt ngang để chuyển tab ══ -->
    <com.pompom.group6.utils.SwipeTabFrameLayout
        android:id="@+id/tabContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Panel: Thước phim -->
            <LinearLayout
                android:id="@+id/panelReels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Bộ lọc theo nguồn mạng xã hội -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/chipSourceAll"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_label_pink"
                            android:text="Tất cả"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/chipSourceInstagram"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:text="Instagram" />

                        <TextView
                            android:id="@+id/chipSourceTiktok"
                            style="@style/ReelSourceChip"
                            android:layout_marginEnd="8dp"
                            android:text="TikTok" />

                        <TextView
                            android:id="@+id/chipSourceFacebook"
                            style="@style/ReelSourceChip"
                            android:text="Facebook" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReels"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="90dp" />
            </LinearLayout>

            <!-- Panel: Blog thương hiệu -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBlogFull"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="90dp"
                android:visibility="gone" />

            <!-- Panel: Tips bác sĩ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTipsFull"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="90dp"
                android:visibility="gone" />

            <!-- Panel: Tin gần đây (feed cộng đồng hiện có: Bài viết/Đã lưu/Của bạn) -->
            <LinearLayout
                android:id="@+id/panelNearby"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Stories 24h theo bán kính GPS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFeed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="90dp" />

                        <TextView
                            android:id="@+id/tvFeedEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:paddingHorizontal="32dp"
                            android:text="Chưa có bài viết nào"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </LinearLayout>

            <!-- Speed-dial nổi xuyên suốt mọi tab: bấm nút chính để nảy lên 2 lựa chọn -->
            <LinearLayout
                android:id="@+id/speedDialGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowConsult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_white_pill_button"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Liên hệ tư vấn"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabConsult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fabSize="mini"
                        android:padding="10dp"
                        android:src="@drawable/ic_chat"
                        app:shapeAppearanceOverlay="@style/CircleShape"
                        app:maxImageSize="18dp"
                        app:backgroundTint="@color/white"
                        app:tint="@color/brand_pink"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:pressedTranslationZ="0dp"
                        app:hoveredFocusedTranslationZ="0dp"
                        android:contentDescription="Liên hệ tư vấn" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowCreatePost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_white_pill_button"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Tạo bài viết"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabAddPost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fabSize="mini"
                        android:padding="10dp"
                        android:src="@drawable/ic_plus"
                        app:shapeAppearanceOverlay="@style/CircleShape"
                        app:maxImageSize="18dp"
                        app:backgroundTint="@color/white"
                        app:tint="@color/brand_pink"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:pressedTranslationZ="0dp"
                        app:hoveredFocusedTranslationZ="0dp"
                        android:contentDescription="Tạo bài viết mới" />
                </LinearLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabMain"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="end"
                    android:padding="16dp"
                    android:src="@drawable/ic_plus"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    app:maxImageSize="20dp"
                    app:backgroundTint="@color/brand_pink"
                    app:tint="@color/white"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:hoveredFocusedTranslationZ="0dp"
                    android:contentDescription="Tạo bài viết / Liên hệ tư vấn" />

            </LinearLayout>

    </com.pompom.group6.utils.SwipeTabFrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
