<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_pink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_left_chevron"
            app:tint="@color/white"
            tools:ignore="ContentDescription"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Cài đặt"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="32dp">

            <!-- Notifications section -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="Thông báo" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications"
                        style="@style/SettingsSwitch"
                        android:text="Nhận thông báo đẩy"
                        app:trackTint="@color/switch_track_tint" />

                    <View style="@style/SettingsDivider" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPromoEmails"
                        style="@style/SettingsSwitch"
                        android:text="Nhận email khuyến mãi"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hỗ trợ & tài khoản — gộp từ card "Cài đặt & hỗ trợ" cũ trên trang Me, giờ chỉ
                 còn 1 điểm vào duy nhất qua icon ⚙️ trên header. -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="Hỗ trợ &amp; tài khoản" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAddress"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Địa chỉ giao hàng" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowSupportContact"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Liên hệ tư vấn / CSKH" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowLanguage"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Ngôn ngữ" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- General section -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="Chung" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowClearCache"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Xóa bộ nhớ đệm" />

                        <TextView
                            android:id="@+id/tvCacheSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="0 MB"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowChangePassword"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Đổi mật khẩu" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About section -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="Về ứng dụng" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowPolicyHelp"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Chính sách &amp; trợ giúp" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowPrivacy"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Chính sách bảo mật" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowTerms"
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Điều khoản sử dụng" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Phiên bản" />

                        <TextView
                            android:id="@+id/tvVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="1.0.0"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="@color/brand_pink"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_pink"
                app:strokeColor="@color/brand_pink"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
