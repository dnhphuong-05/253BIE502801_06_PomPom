<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardShip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/brand_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_pink_light"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <RadioButton
            android:id="@+id/rbShip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand_pink"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvShipName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium" android:text="Giao hàng"
                android:textColor="@color/text_primary" android:textSize="14sp" />

            <TextView android:id="@+id/tvShipDesc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular" android:text=""
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:id="@+id/tvShipFee" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold" android:text="Miễn phí"
            android:textColor="@color/brand_pink" android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
