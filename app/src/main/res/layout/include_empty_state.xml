<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.5"
        android:src="@drawable/ic_bag"
        app:tint="@color/brand_pink"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvEmptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Không có dữ liệu"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- CTA tuỳ chọn: ẩn mặc định, chỉ hiện khi màn nào đó set text + bật visibility
         (vd "Lịch sử tư vấn" -> "Gửi yêu cầu tư vấn mới"). Không ảnh hưởng các màn khác
         vì id này không được tham chiếu ở nơi khác. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyCta"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_medium"
        android:minWidth="200dp"
        android:paddingHorizontal="20dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:backgroundTint="@color/brand_pink"
        app:cornerRadius="22dp"
        app:rippleColor="@color/ripple_pink"
        tools:text="Gửi yêu cầu tư vấn mới"
        tools:visibility="visible" />
</LinearLayout>
