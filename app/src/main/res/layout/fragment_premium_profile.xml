<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <!-- ============================ HEADER (Bước 2) ============================ -->
    <!-- Nền header = md_theme_light_primary; statusBarForeground cùng màu để status bar
         liền mạch với header (Bước 1). -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_light_primary"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false"
        app:statusBarForeground="@color/md_theme_light_primary">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivAvatarFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/khung_avatar"
                    tools:ignore="ContentDescription" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar"
                    app:shapeAppearanceOverlay="@style/CircleShape"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_crown_gold"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/avatarContainer"
                app:layout_constraintEnd_toStartOf="@id/btnSettingsHeader"
                app:layout_constraintStart_toEndOf="@id/avatarContainer"
                app:layout_constraintTop_toTopOf="@id/avatarContainer"
                app:layout_constraintVertical_bias="0.1">

                <!-- Bỏ icon vương miện nhỏ cạnh tên: đã có badge vương miện trên avatar VÀ icon
                     trong pill "Diamond Member" ngay dưới — lặp lại lần 3 là thừa, nhường chỗ
                     cho tên đầy đủ (nhất là khi header giờ có thêm icon Cài đặt). -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    tools:text="Thảo Nguyên" />

                <LinearLayout
                    android:id="@+id/btnMembership"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_white_pill_button"
                    android:gravity="center_vertical"
                    android:maxWidth="180dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_crown_gold"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvMemberLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="1"
                        android:textColor="@color/brand_pink"
                        android:textSize="12sp"
                        tools:text="Diamond Member" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Yêu thích makeup"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Nút cài đặt: gộp toàn bộ Cài đặt & hỗ trợ + Đăng xuất vào 1 điểm vào duy nhất
                 trên header, thay vì nút rời trôi nổi ở cuối trang (kiểu Shopee). -->
            <ImageView
                android:id="@+id/btnSettingsHeader"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:contentDescription="Cài đặt"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                app:layout_constraintEnd_toStartOf="@id/btnEditProfile"
                app:layout_constraintTop_toTopOf="@id/btnEditProfile"
                app:tint="@color/brand_pink" />

            <!-- Nút sửa hồ sơ: icon bút nhỏ ở góc trên bên phải header -->
            <ImageView
                android:id="@+id/btnEditProfile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:contentDescription="Chỉnh sửa hồ sơ"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_edit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_pink" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===================== LOADING SKELETON (Bước 8) ===================== -->
            <LinearLayout
                android:id="@+id/skeletonView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <!-- ===================== ERROR STATE (Bước 8) ===================== -->
            <LinearLayout
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="80dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.5"
                    android:src="@drawable/ic_report"
                    app:tint="@color/brand_pink"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Không tải được hồ sơ. Vui lòng kiểm tra kết nối và thử lại."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Thử lại"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_pink"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/brand_pink" />
            </LinearLayout>

            <!-- ===================== CONTENT ===================== -->
            <LinearLayout
                android:id="@+id/contentView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <!-- Stats: Người theo dõi / Đang theo dõi / Story (Bước 2) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="16dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatFollowers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                tools:text="3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Người theo dõi"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/md_theme_light_surfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatFollowing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                tools:text="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Đang theo dõi"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/md_theme_light_surfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatStories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Story"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Đơn hàng của tôi — đôn lên ngay sau stats theo đúng ưu tiên Shopee
                     (đơn hàng là hành động người dùng quay lại thường xuyên nhất). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMyOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/ripple_pink"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Đơn hàng của tôi"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Xem lịch sử mua hàng ›"
                                android:textColor="@color/text_secondary"
                                android:textSize="12.5sp" />
                        </RelativeLayout>

                        <!-- Đường kẻ mảnh tách tiêu đề khỏi dải icon, kiểu Shopee. -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="@color/divider_light" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:weightSum="5">

                            <include android:id="@+id/statusPending" layout="@layout/item_order_status_demo" />
                            <include android:id="@+id/statusPacking" layout="@layout/item_order_status_demo" />
                            <include android:id="@+id/statusShipping" layout="@layout/item_order_status_demo" />
                            <include android:id="@+id/statusDelivered" layout="@layout/item_order_status_demo" />
                            <include android:id="@+id/statusReturn" layout="@layout/item_order_status_demo" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hồ sơ làn da — icon mỗi dòng có chip màu riêng (hồng/lavender/vàng/đỏ)
                     lấy từ đúng bộ màu thương hiệu sẵn có. Giữ nguyên: đây là giá trị riêng
                     của PomPom mà Shopee không có. CTA cuối card nối sang sản phẩm phù hợp thật. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Hồ sơ làn da"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Giúp PomPom gợi ý mỹ phẩm sát với làn da của bạn hơn"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <include android:id="@+id/rowSkinType" layout="@layout/item_skin_profile_row" />
                        <include android:id="@+id/rowSkinConcern" layout="@layout/item_skin_profile_row" />
                        <include android:id="@+id/rowSkinTone" layout="@layout/item_skin_profile_row" />
                        <include android:id="@+id/rowAvoid" layout="@layout/item_skin_profile_row" />
                        <include android:id="@+id/rowBirthday" layout="@layout/item_skin_profile_row" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSkinRecommend"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/brand_pink"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Xem sản phẩm phù hợp với da của bạn"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_shopping"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ví mua sắm (rút gọn từ "Tiện ích mua sắm") — chỉ giữ 3 mục có dữ liệu
                     đáng xem thường xuyên. "Địa chỉ" chuyển vào Cài đặt (giống Shopee: quản lý
                     địa chỉ là việc làm 1 lần, không cần chiếm chỗ trang chính); "Đã xem" bỏ hẳn
                     vì chưa có dữ liệu thật; "Đánh giá" đã có ở "Hoạt động của tôi", tránh trùng. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Ví mua sắm"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <include android:id="@+id/featWishlist" layout="@layout/item_profile_feature" />
                            <include android:id="@+id/featVoucher" layout="@layout/item_profile_feature" />
                            <include android:id="@+id/featPoints" layout="@layout/item_profile_feature" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hoạt động của tôi (gộp từ "Hoạt động cộng đồng", giữ nguyên 4 mục —
                     "Đánh giá" giờ chỉ xuất hiện ở đây, không còn trùng với Ví mua sắm). -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Hoạt động của tôi"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <include android:id="@+id/rowStory" layout="@layout/item_profile_menu" />
                        <include android:id="@+id/rowReviews" layout="@layout/item_profile_menu" />
                        <include android:id="@+id/rowSaved" layout="@layout/item_profile_menu" />
                        <include android:id="@+id/rowConsultation" layout="@layout/item_profile_menu" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- "Cài đặt & hỗ trợ" + nút Cài đặt/Đăng xuất rời đã CHUYỂN vào SettingsActivity,
                     mở từ icon ⚙️ trên header — tránh 1 khái niệm xuất hiện 3 hình thức khác nhau
                     trên cùng 1 trang (xem PremiumProfileFragment.setupStaticActions). -->

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
