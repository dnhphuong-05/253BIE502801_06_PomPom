<?xml version="1.0" encoding="utf-8"?>
<!-- Popup thông tin (Chính sách bảo mật / Điều khoản sử dụng...) theo concept PomPom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_pompom"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@color/brand_background"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivInfoIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_report"
            android:contentDescription="@null"
            app:tint="@color/brand_pink" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvInfoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Tiêu đề"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        tools:ignore="HardcodedText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="320dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvInfoMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Nội dung"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInfoClose"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Đóng"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_pink"
        app:cornerRadius="12dp"
        tools:ignore="HardcodedText" />
</LinearLayout>
