<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="110dp"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#FCE4E4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/promotion">

        <!-- Left panel: title + meta info, fills height evenly -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Giảm 10% cho đơn từ 500.000đ"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="3">

                <LinearLayout android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tối đa giảm"
                        android:textSize="10sp"
                        android:textColor="#9E9E9E"/>
                    <TextView
                        android:id="@+id/tvMaxDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100.000đ"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HSD"
                        android:textSize="10sp"
                        android:textColor="#9E9E9E"/>
                    <TextView
                        android:id="@+id/tvExpiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30/06/2025"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn lại"
                        android:textSize="10sp"
                        android:textColor="#9E9E9E"/>
                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150 lượt"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

            </GridLayout>

        </LinearLayout>

        <!-- Right coupon stub: code + value, perfectly centered, no drift -->
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvVoucherCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="POMPOM10"
                android:textColor="@color/brand_pink"
                android:textSize="12sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvVoucherValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Giảm 10%"
                android:textColor="@color/brand_pink"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
