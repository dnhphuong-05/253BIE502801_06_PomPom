<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical">

    <!-- ── Drag handle ── -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#D8B4C8" />

    <!-- ── Sheet title ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:text="Bộ lọc bài viết"
        android:textColor="@color/text_primary"
        android:textSize="17sp" />

    <!-- ── Sắp xếp ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Sắp xếp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipSortNewest"
            style="@style/ReelSourceChip"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_label_pink"
            android:text="Mới nhất"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipSortPopular"
            style="@style/ReelSourceChip"
            android:text="Phổ biến nhất" />
    </LinearLayout>

    <!-- ── Hiển thị ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Hiển thị"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipShowAll"
            style="@style/ReelSourceChip"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_label_pink"
            android:text="Tất cả"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipShowFollowing"
            style="@style/ReelSourceChip"
            android:text="Đang theo dõi" />
    </LinearLayout>

    <!-- ── Footer: Đặt lại / Áp dụng ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCommunityFilter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="Đặt lại"
                android:textColor="@color/brand_pink"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/brand_pink"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCommunityFilter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="Áp dụng"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_pink"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
