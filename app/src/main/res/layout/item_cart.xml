<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="20dp">

    <!-- Divider TOP -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product image -->
    <ImageView
        android:id="@+id/ivCartProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerInside"
        android:background="@drawable/bg_white_pill_button"
        android:backgroundTint="#FDF2F2"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Remove button (Top Right relative to details) -->
    <ImageView
        android:id="@+id/btnCartRemove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivCartProduct"
        app:tint="@color/text_secondary" />

    <!-- Product name -->
    <TextView
        android:id="@+id/tvCartName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Gift - Vanity Mirror"
        app:layout_constraintStart_toEndOf="@id/ivCartProduct"
        app:layout_constraintEnd_toStartOf="@id/btnCartRemove"
        app:layout_constraintTop_toTopOf="@id/ivCartProduct" />

    <!-- Variant/Option (Optional) -->
    <TextView
        android:id="@+id/tvCartVariant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:text="Option: Pink"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="@id/tvCartName"
        app:layout_constraintTop_toBottomOf="@id/tvCartName" />

    <!-- Quantity row -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        app:strokeColor="@color/brand_pink"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="@id/tvCartName"
        app:layout_constraintTop_toBottomOf="@id/tvCartVariant">
        <LinearLayout
            android:id="@+id/layoutQty"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btnCartMinus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="8dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCartQty"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:text="1" />

            <ImageView
                android:id="@+id/btnCartPlus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="8dp"
                android:src="@drawable/ic_plus"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- Prices (Original + Sale) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvCartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="$142.00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#EF9A9A"
            android:textSize="15sp"
            android:text="$79.00" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
