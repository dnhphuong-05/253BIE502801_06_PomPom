<?xml version="1.0" encoding="utf-8"?>
<!-- Ô tính năng mua sắm trong lưới Profile (icon + số liệu thật + nhãn). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/ivFeatureIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_feature"
            android:padding="13dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/brand_pink"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvFeatureBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_pink_circle"
            android:fontFamily="@font/poppins_semibold"
            android:minWidth="18dp"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:gravity="center"
            android:visibility="gone"
            tools:text="9"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvFeatureLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:maxLines="2"
        android:text="Yêu thích"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

</LinearLayout>
