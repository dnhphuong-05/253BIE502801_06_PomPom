<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Group6" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- Transparent status bar: app content draws behind it and stays in sync
             with the screen background. Most screens use a light background, so
             status bar icons default to dark; screens with a coloured header
             (e.g. MainActivity) override this dynamically at runtime. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Group6" parent="Base.Theme.Group6" />

    <style name="Theme.Group6.FullScreen" parent="Theme.Group6">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="VoucherTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CircleShape">
        <item name="cornerSize">50%</item>
    </style>
</resources>