<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ribbon background with notch at the bottom -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_pink" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Notch -->
    <item
        android:top="32dp"
        android:bottom="-12dp"
        android:left="4dp"
        android:right="4dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="#FEF0F0" />
            </shape>
        </rotate>
    </item>
</layer-list>